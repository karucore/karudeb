# karu64 RV64IMAC soft-float BusyBox fragment.
#
# Applied after BusyBox allnoconfig. The binary is static rv64imac/lp64, so it
# has no F/D instructions and needs no dynamic loader in the initramfs.

CONFIG_HAVE_DOT_CONFIG=y
CONFIG_BUSYBOX=y

CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_CROSS_COMPILER_PREFIX="riscv64-unknown-linux-musl-"
CONFIG_SYSROOT=""
CONFIG_EXTRA_CFLAGS="-march=rv64imac -mabi=lp64"
CONFIG_EXTRA_LDFLAGS="-march=rv64imac -mabi=lp64"

CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_FEATURE_COPYBUF_KB=4
CONFIG_MONOTONIC_SYSCALL=y

# CONFIG_FEATURE_EDITING is not set
# CONFIG_FEATURE_EDITING_ASK_TERMINAL is not set
# CONFIG_FEATURE_EDITING_FANCY_PROMPT is not set
# CONFIG_FEATURE_TAB_COMPLETION is not set
# CONFIG_UNICODE_SUPPORT is not set

CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y

CONFIG_CTTYHACK=y
CONFIG_SETSID=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FREE=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_MKNOD=y
CONFIG_MKDIR=y
CONFIG_LN=y
CONFIG_RM=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_GREP=y
CONFIG_UNAME=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_HALT=y
CONFIG_SYNC=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_PRINTF=y
CONFIG_PS=y
CONFIG_DMESG=y
CONFIG_STTY=y
CONFIG_KILL=y
CONFIG_DD=y
CONFIG_HEXDUMP=y

# CONFIG_FEATURE_IPV6 is not set
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_FEATURE_IFCONFIG_HW=y
CONFIG_FEATURE_IFCONFIG_BROADCAST_PLUS=y
CONFIG_IP=y
CONFIG_IPADDR=y
CONFIG_IPLINK=y
CONFIG_IPROUTE=y
CONFIG_IPNEIGH=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_NEIGH=y
CONFIG_ROUTE=y
CONFIG_NETSTAT=y
CONFIG_PING=y
# CONFIG_PING6 is not set
CONFIG_ARPING=y
CONFIG_NSLOOKUP=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_FEATURE_UDHCPC_SANITIZEOPT=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
CONFIG_UDHCPC_DEFAULT_INTERFACE="eth0"
CONFIG_UDHCPC_SLACK_FOR_BUGGY_SERVERS=80
