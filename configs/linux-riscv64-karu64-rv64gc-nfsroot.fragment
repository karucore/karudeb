# karu64 RV64GC NFS-root Linux profile.
#
# This is for the Debian hard-float karudeb rootfs on a scalar RV64GC
# karu64 RTL build. It intentionally leaves V and bring-up-only extra ISA
# alternatives off so the image is a clean scalar control for Linux experiments.

# Core: single-hart RV64GC, S-mode via SBI.
CONFIG_LOCALVERSION="-rv64gc"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_FPU=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_C=y
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_V_DEFAULT_ENABLE is not set
# CONFIG_RISCV_ISA_SUPM is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y

# Benchmarks read cycle/instret directly from U-mode.  With Linux's default
# scounteren policy those CSRs trap; the rootfs sets perf_user_access=2.
CONFIG_PERF_EVENTS=y
CONFIG_RISCV_PMU=y
CONFIG_RISCV_PMU_LEGACY=y
CONFIG_RISCV_PMU_SBI=y

# Slow soft-core timer path: keep the kernel tick modest.
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ=100

# Fixed simple memory map.
CONFIG_FLATMEM_MANUAL=y
# CONFIG_SPARSEMEM_MANUAL is not set

# Console: karu64 NS16550-compatible UART at 0x10000000.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y

# Interrupt controller: legacy PLIC at 0x0c000000.
CONFIG_SIFIVE_PLIC=y

# Device filesystems needed before userspace starts.
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Userspace execution.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_BLK_DEV_INITRD=y

# PTYs are needed for SSH/login shells in the Debian rootfs.
CONFIG_UNIX98_PTYS=y

# Network stack for kernel IP autoconfiguration and NFS root.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_KEY is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set

# karu64 LiteEth MAC. The DT maps the LiteX/LiteEth CSR and slot SRAM windows.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y

# Root filesystem over NFS. Keep this built in.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_ROOT_NFS=y
CONFIG_NFS_V3=y
# CONFIG_NFS_V4 is not set
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
CONFIG_NFS_DISABLE_UDP_SUPPORT=y

# Avoid unused virtual/device subsystems on this board profile.
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_PCI is not set
# CONFIG_KVM is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO is not set
# CONFIG_NET_9P is not set
# CONFIG_9P_FS is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PINCTRL is not set
# CONFIG_GPIOLIB is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NTFS3_FS is not set

# Deterministic soft-core: avoid jitterentropy/DRBG stalls selected via NET.
# CONFIG_CRYPTO_GHASH_RISCV64 is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set
# CONFIG_CRYPTO_HW is not set
# CONFIG_CRYPTO_AUTHENC is not set
# CONFIG_CRYPTO_GCM is not set
# CONFIG_CRYPTO_GENIV is not set
# CONFIG_CRYPTO_SEQIV is not set
# CONFIG_CRYPTO_ECHAINIV is not set
# CONFIG_CRYPTO_RNG_DEFAULT is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_DRBG is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set

# Keep debug/tracing out of the bring-up image unless explicitly requested.
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_KALLSYMS is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_TRACEPOINTS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_FRAME_POINTER is not set
# CONFIG_MEMTEST is not set
# CONFIG_RUNTIME_KERNEL_TESTING_MENU is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_THERMAL is not set
# CONFIG_HWMON is not set
# CONFIG_WATCHDOG is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_SECCOMP is not set
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
