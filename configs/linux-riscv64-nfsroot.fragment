# Core RISC-V Linux features.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_FPU=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=y

# Basic device filesystem for an initramfs-less boot.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ns16550/8250 serial console, as used by QEMU virt and many small boards.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y

# Networking needed before userspace starts.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y

# Root filesystem over NFS. Keep these built in.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_ROOT_NFS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_SUNRPC=y
CONFIG_LOCKD=y

# QEMU virt networking. Replace or augment this with your board Ethernet driver.
CONFIG_NETDEVICES=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y

# QEMU ext4 root disk for the JWM/VNC smoke test.
CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y

# QEMU user-level root filesystem transport. Keep this built in for 9p root.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Useful during bring-up.
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_KERNEL=y
