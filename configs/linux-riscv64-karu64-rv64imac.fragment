# karu64 RV64IMAC soft-float Linux profile with LiteEth.
#
# Applied on top of allnoconfig. This profile matches the lean VCU118 Ethernet
# bring-up bitstream: rv64imac + Zicsr/Zifencei, no F/D/V. RISC-V Linux does not
# emulate userspace FP, so the paired BusyBox initramfs is also lp64 soft-float.

CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
# CONFIG_FPU is not set
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_SBI=y
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y

CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ=100

CONFIG_FLATMEM_MANUAL=y
# CONFIG_SPARSEMEM_MANUAL is not set

CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
# CONFIG_VT is not set

CONFIG_SIFIVE_PLIC=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y

CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_KEY is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set

CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y

CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_ROOT_NFS=y
CONFIG_NFS_V3=y
# CONFIG_NFS_V4 is not set
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
CONFIG_NFS_DISABLE_UDP_SUPPORT=y

